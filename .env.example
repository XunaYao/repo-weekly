# Optional for public repositories. Use a fine-grained personal access token
# with read-only "Contents" permission when you need a higher GitHub API limit.
GITHUB_TOKEN=

# Zhipu GLM API key. Keep the actual key only in .env.local.
ZHIPU_API_KEY=

# Optional: defaults to glm-4.7-flash.
ZHIPU_MODEL=glm-4.7-flash
